{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Datart",
  "version": "0.1.5",
  "identifier": "com.datart.desktop",
  "build": {
    "beforeDevCommand": "node scripts/web-dev.mjs",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/web-build.mjs",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Datart",
        "width": 1200,
        "height": 820,
        "minWidth": 820,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
