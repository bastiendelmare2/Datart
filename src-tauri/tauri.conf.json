{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Datart",
  "version": "0.1.5",
  "identifier": "com.datart.desktop",
  "build": {
    "beforeDevCommand": "node scripts/web-dev.mjs",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/web-build.mjs",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Datart",
        "width": 1200,
        "height": 820,
        "minWidth": 820,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bastiendelmare2/Datart/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwMDREQjA3Q0JENDY2QzQKUldURVp0VExCOXNFc0xEM2E1c29EalpDMGVlb2xENzlqa3FDcTQrZzhHbWlrT2dQUVBQcGxGankK"
    }
  }
}
